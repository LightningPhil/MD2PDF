{
  "name": "canvadoc-typesetter",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "api:check": "node ./scripts/check-public-api.mjs",
    "api:update": "node ./scripts/update-public-api-snapshot.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "opentype.js": "^1.3.4",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
