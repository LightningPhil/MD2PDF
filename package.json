{
  "name": "md2pdf",
  "version": "0.1.0",
  "description": "Web app that loads/edits Markdown and renders it live as paginated A4-style pages with KaTeX math support",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/workspace.e2e.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:pages": "tsc && vite build --mode pages",
    "test:pages": "node tests/pages.e2e.mjs",
    "prebuild": "node scripts/license-notices.mjs",
    "prebuild:pages": "node scripts/license-notices.mjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^20.0.0",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^20.5.0",
    "jsdom": "^28.0.0",
    "playwright": "^1.51.1",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "jszip": "^3.10.2",
    "katex": "^0.16.0",
    "marked": "^12.0.0",
    "mathlive": "^0.111.1"
  },
  "author": "Philip Leichauer",
  "license": "MIT",
  "homepage": "https://lightningphil.github.io/MD2PDF/",
  "repository": {
    "type": "git",
    "url": "https://github.com/LightningPhil/MD2PDF.git"
  }
}
