{
  "name": "md2pdf",
  "version": "0.2.0",
  "description": "Web app that loads/edits Markdown and renders it live as paginated pages with full math support. Features client-side PDF export.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^20.0.0",
    "happy-dom": "^20.5.0",
    "jsdom": "^28.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "jszip": "^3.10.1",
    "opentype.js": "^1.3.4",
    "pdf-lib": "^1.17.1"
  },
  "author": "Philip Leichauer",
  "license": "MIT"
}
