{
  "name": "md2pdf",
  "version": "0.1.0",
  "description": "Web app that loads/edits Markdown and renders it live as paginated A4-style pages with KaTeX math support",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "export:pdf": "node scripts/export-pdf.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^20.0.0",
    "happy-dom": "^20.5.0",
    "jsdom": "^28.0.0",
    "playwright": "^1.51.1",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "katex": "^0.16.0",
    "marked": "^12.0.0"
  },
  "author": "Philip Leichauer",
  "license": "MIT"
}
